def validar(datos):
    problemas = []

    pesos_invalidos = (datos["peso_estimado_g"] <= 0).sum()

    if pesos_invalidos > 0:
        problemas.append(
            f"Hay {pesos_invalidos} pesos no positivos"
        )

    certeza = pd.to_numeric(
        datos["certeza_observador"].astype(str),
        errors="coerce"
    )

    certezas_invalidas = (~certeza.between(1, 5)).sum()

    if certezas_invalidas > 0:
        problemas.append(
            f"Hay {certezas_invalidas} valores de certeza fuera de rango"
        )

    aristas_invalidas = (datos["num_aristas"] < 0).sum()

    if aristas_invalidas > 0:
        problemas.append(
            f"Hay {aristas_invalidas} conteos de aristas negativos"
        )

    ids_repetidos = datos["objeto_id"].duplicated().sum()

    if ids_repetidos > 0:
        problemas.append(
            f"Hay {ids_repetidos} identificadores repetidos"
        )

    return problemas


